# Backend Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/intelligent_email_assistant

# Session & Security
SESSION_SECRET=dev_session_secret_key_change_in_production_min32chars
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 & Gmail Integration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Google Gemini AI Integration (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
